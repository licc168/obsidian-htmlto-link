{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES6",
		"allowJs": true,
		"strict": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"lib": ["DOM", "ES5", "ES6", "ES7", "ES2017"],
		"paths": {
			"obsidian": ["types/obsidian.d.ts"],
			"mermaid": ["types/mermaid.d.ts"],
			"highlight.js/lib/common": ["types/highlightjs.d.ts"]
		}
	},
	"include": ["**/*.ts", "types/**/*.d.ts"]
}

{
	"name": "htmlto-link-obsidian",
	"version": "0.1.19",
	"description": "Instantly share an Obsidian note as a beautiful webpage and copy the public link",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src --max-warnings=0",
		"sync:templates": "node scripts/sync-template-assets.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"htmlto.link",
		"markdown",
		"publish",
		"share"
	],
	"author": "htmlto.link",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^0.14.0",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "5.8.3",
		"typescript-eslint": "^8.68.0"
	},
	"dependencies": {
		"highlight.js": "^11.12.0",
		"mermaid": "^11.17.2"
	}
}
